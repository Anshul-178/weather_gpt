/android/app/release

# Bundled on-device AI model (~769 MB, license-gated) — fetched manually per
# machine; see assets/models/README.md. The folder itself stays in git so the
# pubspec asset entry always resolves.
assets/models/*.task
assets/models/*.gguf

# (Nothing here yet — GGUF etc. live in assets/models/ and are git-ignored
# there; they ARE bundled into the APK by the llama.cpp engine.)
